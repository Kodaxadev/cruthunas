{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://kodaxadev.github.io/cruthunas/schemas/framework-release-v1.json","title":"Cruthunas Framework Release Attestation","type":"object","required":["schema_version","framework","released_at"],"properties":{"schema_version":{"const":1},"framework":{"type":"object","required":["repository","version","commit"],"properties":{"repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},"version":{"type":"string","pattern":".*\\S.*"},"commit":{"type":"string","pattern":"^[0-9a-f]{40}$"}},"additionalProperties":false},"released_at":{"type":"string","format":"date-time"},"release_url":{"type":["string","null"]},"notes":{"type":["string","null"]}},"additionalProperties":false}
