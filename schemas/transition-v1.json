{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodaxadev.github.io/cruthunas/schemas/transition-v1.json",
  "title": "Cruthunas Claim Transition",
  "type": "object",
  "required": ["schema_version", "claim_id", "axis", "operation", "from", "to", "requested_by", "approved_by", "evidence", "reason", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "claim_id": {"type": "string", "pattern": "^[A-Z][0-9]{3,}$"},
    "axis": {"enum": ["gate", "epistemic", "verification", "publication"]},
    "operation": {"enum": ["set", "add", "remove"]},
    "from": {},
    "to": {},
    "requested_by": {"type": "string", "minLength": 1},
    "approved_by": {"type": "object", "required": ["type", "id"], "properties": {"type": {"enum": ["human", "policy", "venue"]}, "id": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^E-[A-Z][0-9]{3,}-[0-9]{4,}$"}},
    "reason": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"axis": {"const": "verification"}}}, "then": {"properties": {"operation": {"enum": ["add", "remove"]}}}},
    {"if": {"properties": {"axis": {"enum": ["gate", "epistemic", "publication"]}}}, "then": {"properties": {"operation": {"const": "set"}}}}
  ],
  "additionalProperties": false
}
