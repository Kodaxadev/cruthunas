{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://kodaxadev.github.io/cruthunas/schemas/claims-v1.json","title":"Cruthúnas Claim Ledger","type":"object","required":["schema_version","claims"],"properties":{"schema_version":{"type":"integer","const":1},"claims":{"type":"array","items":{"$ref":"#/$defs/claim"}}},"additionalProperties":false,"$defs":{"claimId":{"type":"string","pattern":"^[A-Z][0-9]{3,}$"},"claimAlias":{"type":"string","pattern":"^[A-Z][A-Z0-9-]*$","description":"Normalized historical identifier. Aliases are provenance metadata, not substitutes where a canonical ID is required."},"evidenceId":{"type":"string","pattern":"^E-[A-Z][0-9]{3,}-[0-9]{4,}$"},"claim":{"type":"object","required":["id","kind","statement","epistemic_status","verification_statuses","publication_status","gate","dependencies","evidence","source_document","limitations","introduced_at","updated_at"],"properties":{"id":{"$ref":"#/$defs/claimId"},"aliases":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/claimAlias"},"default":[]},"kind":{"type":"string","enum":["CONJECTURE","DEFINITION","LEMMA","THEOREM","COROLLARY","COMPUTATIONAL_RESULT","COUNTEREXAMPLE"]},"title":{"type":"string","minLength":1},"statement":{"type":"string","minLength":1,"description":"Exact registered statement, including domain and quantifiers."},"scope":{"type":["string","null"],"description":"Explicit bounded or restricted scope when the statement is not universal."},"epistemic_status":{"enum":["OPEN","HEURISTIC","COMPUTATIONAL","PROVED","REFUTED"]},"verification_statuses":{"description":"Cumulative verification marks. UNCHECKED must appear alone.","oneOf":[{"type":"array","const":["UNCHECKED"]},{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["INTERNAL_AUDIT","INDEPENDENT_REPRODUCTION","FORMALIZED","EXTERNAL_REVIEW"]}}]},"publication_status":{"enum":["WORKING","FROZEN","PREPRINT","SUBMITTED","PUBLISHED","CORRECTED","WITHDRAWN"]},"gate":{"type":"integer","minimum":0