{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodaxadev.github.io/cruthunas/schemas/project-v1.json",
  "title": "Cruthunas Project Adoption Manifest",
  "type": "object",
  "required": ["schema_version", "framework", "profile", "project", "canonical", "policies"],
  "properties": {
    "schema_version": {"const": 1},
    "framework": {
      "type": "object",
      "required": ["repository", "version", "commit"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "profile": {"type": "string", "minLength": 1},
    "project": {
      "type": "object",
      "required": ["id", "title", "maintainers"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "maintainers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["github"],
            "properties": {"github": {"type": "string", "minLength": 1}},
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "canonical": {
      "type": "object",
      "required": ["claim_ledger", "research_charter", "evidence_root", "transition_root", "release_manifest"],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "toolchains": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "policies": {"type": "object", "additionalProperties": {"type": ["boolean", "string", "integer", "number", "null"]}}
  },
  "additionalProperties": false
}
