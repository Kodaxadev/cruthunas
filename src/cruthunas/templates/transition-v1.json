{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://kodaxadev.github.io/cruthunas/schemas/transition-v1.json","title":"Cruthunas Claim Transition","type":"object","required":["schema_version","claim_id","axis","from","to","requested_by","approved_by","evidence","reason","created_at"],"properties":{"schema_version":{"const":1},"claim_id":{"type":"string","pattern":"^[A-Z][0-9]{3,}$","description":"Canonical claim ID; aliases are not accepted."},"axis":{"enum":["gate","epistemic","verification","publication"]},"from":{},"to":{},"requested_by":{"$ref":"#/$defs/nonBlank","description":"Durable identity of the person or agent requesting the transition."},"approved_by":{"type":"object","description":"Policy, venue, or human approval identity. Approval does not imply evidence creation or independent review.","required":["type","id"],"properties":{"type":{"enum":["human","policy","venue"]},"id":{"$ref":"#/$defs/nonBlank"}},"additionalProperties":false},"evidence":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^E-[A-Z][0-9]{3,}-[0-9]{4,}$"}},"reason":{"$ref":"#/$defs/nonBlank"},"created_at":{"type":"string","format":"date-time"}},"allOf":[{"if":{"properties":{"axis":{"const":"gate"}},"required":["axis"]},"then":{"properties":{"from":{"type":"integer","minimum":0,"maximum":10},"to":{"type":"integer","minimum":0,"maximum":10}}}},{"if":{"properties":{"axis":{"const":"epistemic"}},"required":["axis"]},"then":{"properties":{"from":{"$ref":"#/$defs/epistemic"},"to":{"$ref":"#/$defs/epistemic"}}}},{"if":{"properties":{"axis":{"const":"publication"}},"required":["axis"]},"then":{"properties":{"from":{"$ref":"#/$defs/publication"},"to":{"$ref":"#/$defs/publication"}}}},{"if":{"properties":{"axis":{"const":"verification"}},"required":["axis"]},"then":{"properties":{"from":{"$ref":"#/$defs/verificationSet"},"to":{"$ref":"#/$defs/verificationSet"}}}}],"$defs":{"nonBlank":{"type":"string","pattern":".*\\S.*"},"epistemic":{"type":"