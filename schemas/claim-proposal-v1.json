{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodaxadev.github.io/cruthunas/schemas/claim-proposal-v1.json",
  "title": "Cruthunas Claim Proposal",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "kind",
    "statement",
    "dependencies",
    "source_document",
    "limitations",
    "proposed_at",
    "proposed_by"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][0-9]{3,}$"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9-]*$"
      },
      "default": []
    },
    "kind": {
      "type": "string",
      "enum": [
        "CONJECTURE",
        "DEFINITION",
        "LEMMA",
        "THEOREM",
        "COROLLARY",
        "COMPUTATIONAL_RESULT",
        "COUNTEREXAMPLE"
      ]
    },
    "title": {
      "$ref": "#/$defs/nonBlank"
    },
    "statement": {
      "$ref": "#/$defs/nonBlank"
    },
    "scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][0-9]{3,}$"
      },
      "description": "Canonical claim IDs only; aliases are not accepted."
    },
    "source_document": {
      "$ref": "#/$defs/nonBlank"
    },
    "proof_location": {
      "type": [
        "string",
        "null"
      ]
    },
    "formal_declarations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonBlank"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonBlank"
      }
    },
    "proposed_at": {
      "type": "string",
      "format": "date-time"
    },
    "proposed_by": {
      "$ref": "#/$defs/nonBlank",
      "description": "Durable identity of the proposal originator; distinct from later record creators, requesters, approvers, and reviewers."
    }
  },
  "$defs": {
    "nonBlank": {
      "type": "string",
      "pattern": ".*\\S.*"
    }
  },
  "additionalProperties": false
}
