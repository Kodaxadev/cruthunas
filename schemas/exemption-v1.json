{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodaxadev.github.io/cruthunas/schemas/exemption-v1.json",
  "title": "Cruthunas Policy Exemption",
  "type": "object",
  "required": ["schema_version", "id", "rule", "scope", "rationale", "approved_by", "created_at", "expires_at"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^X-[0-9]{4,}$"},
    "rule": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rationale": {"type": "string", "minLength": 1},
    "approved_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "replacement_control": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
